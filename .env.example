# Copy to .env and restart. Everything here is read by the frontend server
# (npm run start) and the Vite dev server, never by the browser, except the
# optional VITE_* lines at the bottom.

# Local frontend port (npm run start). Databricks supplies DATABRICKS_APP_PORT.
PORT=8100

# --- Backend services -------------------------------------------------------
# Where the frontend server forwards each service's requests.
# The service list lives in config/serviceRegistry.mjs.
MAP_API_TARGET=http://127.0.0.1:8101
MATCH_API_TARGET=http://127.0.0.1:8102
AUTHOR_API_TARGET=http://127.0.0.1:8103

# Optional bearer tokens, sent by the server to that one service only.
MAP_API_BEARER_TOKEN=
MATCH_API_BEARER_TOKEN=
AUTHOR_API_BEARER_TOKEN=

# --- Optional: call a service directly from the browser ---------------------
# Leave these unset to use the same-origin proxy above (recommended: tokens and
# service addresses stay on the server). If set at build time, the browser calls
# that URL itself and the service must allow this origin with CORS.
# VITE_MAP_API_URL=
# VITE_MATCH_API_URL=
# VITE_AUTHOR_API_URL=
# VITE_API_BASE_URL= # Legacy MAP-only override; prefer VITE_MAP_API_URL.
